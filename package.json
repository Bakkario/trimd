{
  "name": "trimd",
  "version": "0.3.0",
  "license": "MIT",
  "author": "Bakkario",
  "type": "module",
  "bin": {
    "trimd": "dist/trimd.js"
  },
  "scripts": {
    "test": "node --import tsx --test 'test/*.test.ts' 'test/*.test.tsx'",
    "build": "esbuild src/trimd.tsx --bundle --platform=node --format=esm --outfile=dist/trimd.js --banner:js=\"#!/usr/bin/env node\nimport { createRequire } from 'module';\nconst require = createRequire(import.meta.url);\" --log-level=warning && chmod +x dist/trimd.js",
    "start": "node dist/trimd.js",
    "dev": "node --import tsx src/trimd.tsx"
  },
  "dependencies": {
    "cli-highlight": "2.1.11",
    "ink": "8.0.0",
    "markdown-it": "15.0.3",
    "markdown-it-task-lists": "2.1.1",
    "react": "19.3.1",
    "react-devtools-core": "6.1.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "^7.0.2"
  }
}
